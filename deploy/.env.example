# Production settings for deploy/docker-compose.yml. Copy to deploy/.env (never commit it):
#   cp .env.example .env && chmod 600 .env
# Generate each secret with:  openssl rand -base64 36

# --- Secrets -------------------------------------------------------------------------------
POSTGRES_PASSWORD=<generate>
UNSUBSCRIBE_SECRET=<generate>
BOUNCE_SECRET=<generate>
METRICS_TOKEN=<generate>

# --- Identity (must match DNS; see `./mailctl domain add` output and docs/deliverability.md) --
# EHLO name of the server. Its A record must point to the server's public IP, and that IP's PTR
# record must point back to this name.
POSTFIX_HOSTNAME=mail.notify.example.com
# Return-path domain for bounces (VERP). Needs SPF; needs an MX to this server only if you also
# accept late bounces from the internet (docker-compose.inbound.yml).
BOUNCE_DOMAIN=bounces.notify.example.com
# Public HTTPS URL of the API through Cloudflare Tunnel (used in unsubscribe links).
PUBLIC_BASE_URL=https://mail-api.example.com

# --- Sending behaviour ----------------------------------------------------------------------
WORKER_CONCURRENCY=5
MAX_ATTEMPTS=8
# Bulk (batch/newsletter) messages per second, across the whole service. Start low on a new IP
# (see the warm-up plan) and raise gradually.
BULK_RATE_PER_SECOND=2
BATCH_MAX_RECIPIENTS=10000
# Postfix, per recipient domain (gmail.com, outlook.com, ...).
POSTFIX_DESTINATION_CONCURRENCY=5
POSTFIX_DESTINATION_RATE_DELAY=0s
# How long Postfix keeps retrying before giving up. OTPs are useless after an hour, but exam
# notices are not; 1d is a compromise.
POSTFIX_MAX_QUEUE_LIFETIME=1d
# ipv4 unless the server has IPv6 with its own PTR record.
POSTFIX_INET_PROTOCOLS=ipv4

# --- Operations -----------------------------------------------------------------------------
API_PORT=3100
# Optional: Slack/Discord/Mattermost-style webhook for alerts.
# ALERT_WEBHOOK_URL=https://hooks.example.com/...

# --- Optional adapters (off unless set) -----------------------------------------------------
# SES event webhook, only if you add an SES relay route yourself. Not needed for self-hosted mail.
# SES_SNS_TOPIC_ARNS=
