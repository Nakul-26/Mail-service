{
  "name": "eclipse-mail-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch src/api.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "migrate": "tsx src/migrate.ts",
    "create-app": "tsx scripts/create-app.ts",
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/src/api.js",
    "start:worker": "node dist/src/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "set-route": "tsx scripts/set-route.ts",
    "set-recipients": "tsx scripts/set-recipients.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "handlebars": "^4.7.10",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
