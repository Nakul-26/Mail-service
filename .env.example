DATABASE_URL=postgres://mail:mail@localhost:5440/mail
PORT=3100
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:3100
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
UNSUBSCRIBE_SECRET=change-me-to-a-random-string-of-32-plus-chars
# Sending routes. Each app sends via DEFAULT_ROUTE unless set with: npm run set-route
# For each name in SMTP_ROUTES, set SMTP_<NAME>_HOST, _PORT, _SECURE, _REQUIRE_TLS, _USER, _PASS, _RATE_PER_SECOND.
SMTP_ROUTES=ses,selfhosted
DEFAULT_ROUTE=ses
# Your existing SES SMTP endpoint and SMTP credentials (SES console > SMTP settings).
SMTP_SES_HOST=email-smtp.<your-region>.amazonaws.com
SMTP_SES_PORT=587
SMTP_SES_USER=
SMTP_SES_PASS=
# Your account's maximum send rate (SES console > Account dashboard).
SMTP_SES_RATE_PER_SECOND=14
# Your own mail server (demo trial). Every route in SMTP_ROUTES must have a HOST, or the worker will not start.
SMTP_SELFHOSTED_HOST=
SMTP_SELFHOSTED_PORT=587
SMTP_SELFHOSTED_USER=
SMTP_SELFHOSTED_PASS=
WORKER_CONCURRENCY=5
WORKER_POLL_MS=1000
MAX_ATTEMPTS=8
