# Local development settings (copy to .env). Production uses deploy/.env.example instead.
DATABASE_URL=postgres://mail:mail@localhost:5440/mail
PORT=3100
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:3100
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
UNSUBSCRIBE_SECRET=change-me-to-a-random-string-of-32-plus-chars
BOUNCE_SECRET=change-me-to-another-random-string-of-32-chars

# Development sends through a relay route to Mailpit (http://localhost:8025): nothing leaves the
# machine. Production uses the self-hosted Postfix route (deploy/docker-compose.yml).
SMTP_ROUTES=mailpit
DEFAULT_ROUTE=mailpit
SMTP_MAILPIT_KIND=relay
SMTP_MAILPIT_HOST=localhost
SMTP_MAILPIT_PORT=1025
SMTP_MAILPIT_REQUIRE_TLS=false
SMTP_MAILPIT_VERP_DOMAIN=bounces.notify.example.com
DKIM_KEYS_DIR=./secrets/dkim
# Development only: production requires verified sender domains (npm run domain).
ALLOW_UNVERIFIED_SENDER_DOMAINS=true

WORKER_CONCURRENCY=5
WORKER_POLL_MS=1000
MAX_ATTEMPTS=8
BULK_RATE_PER_SECOND=20
